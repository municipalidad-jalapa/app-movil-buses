# Variables de entorno de la aplicacion web de EcoRuta.
#
# Como configurar en local:
#   1. Copiar este archivo a .env
#        macOS / Linux:  cp .env.example .env
#        Windows:        copy .env.example .env
#   2. Sustituir los placeholders por los valores de tu entorno
#   3. npm install && npm run dev
#
# Los archivos .env reales estan en .gitignore y NUNCA se suben.
# Solo se versiona este ejemplo.
#
# Las variables VITE_ quedan visibles en el bundle del navegador.
# No pongas aqui contrasenas, llaves privadas ni tokens de servidor.

# URL base del backend. Debe ser una URL absoluta (http o https), sin barra final.
# Formato: https://host[:puerto]   o   http://host[:puerto]
# En local, con el backend corriendo por docker compose (ver README del backend):
VITE_API_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Avisos del bus  --  Firebase Cloud Messaging (HU-58)
# ---------------------------------------------------------------------------
# Estas siete NO son secretas: viajan en el bundle y cualquiera las lee con
# devtools. El secreto de verdad es la clave de cuenta de servicio de Firebase,
# que vive en el backend y nunca toca este repositorio.
#
# Aun asi no se versionan con valores reales, para que cada entorno apunte a su
# propio proyecto de Firebase. En GitLab van como variables de CI/CD *no
# protegidas*: si las marcas protegidas, los builds de ramas de feature se
# quedan sin ellas.
#
# De donde salen (consola de Firebase):
#   - Las seis primeras: Configuracion del proyecto > Tus apps > App web.
#   - VAPID: Configuracion del proyecto > Cloud Messaging > Web Push certificates
#     > Generate key pair.
#
# O estan las siete, o no esta ninguna. Con algunas puestas la app no arranca:
# un .env a medias casi siempre es un nombre mal escrito, y es mejor fallar que
# dejar los avisos mudos sin explicar por que.
#
# Si se omiten, la aplicacion funciona con los avisos apagados.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=ecoruta-jalapa.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=ecoruta-jalapa
# VITE_FIREBASE_STORAGE_BUCKET=ecoruta-jalapa.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=

# Responde el abordaje en el navegador en vez de llamar al backend.
# Solo para demostrar HU-58 mientras /api/v1/reservas/{id}/abordaje no exista.
# NUNCA en produccion.
# VITE_SIMULAR_ABORDAJE=true

# ---------------------------------------------------------------------------
# Para desplegar (QA y produccion)
# ---------------------------------------------------------------------------
# HU-130: la URL del backend se inyecta en el despliegue mediante un ConfigMap de
# Kubernetes (ver k8s-manifest/{qa,production}/frontend-config.yaml).
#
# Las notificaciones web y el Service Worker exigen contexto seguro. `localhost`
# cuenta como seguro, asi que en desarrollo funcionan. En un entorno publicado
# sobre HTTP con IP publica NO van a llegar: hace falta HTTPS.
