# Variables de entorno de la aplicacion web de EcoRuta.
#
# Como configurar en local:
#   1. Copiar este archivo a .env
#        macOS / Linux:  cp .env.example .env
#        Windows:        copy .env.example .env
#   2. Sustituir los placeholders por los valores de tu entorno
#   3. npm install && npm run dev
#
# Los archivos .env reales estan en .gitignore y NUNCA se suben.
# Solo se versiona este ejemplo.
#
# Las variables VITE_ quedan visibles en el bundle del navegador.
# No pongas aqui contrasenas, llaves privadas ni tokens de servidor.

# URL base del backend. Debe ser una URL absoluta (http o https), sin barra final.
# Formato: https://host[:puerto]   o   http://host[:puerto]
# En local, con el backend corriendo por docker compose (ver README del backend):
VITE_API_BASE_URL=http://localhost:8080

# Firebase Authentication (HU-129). Valores de la consola de Firebase,
# proyecto web. No son secretos de servidor, pero no uses los de produccion
# en desarrollo si podes evitarlo.
VITE_FIREBASE_API_KEY=reemplazar-api-key
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=1:123:web:abc

# Avisos del bus (HU-58) -- Firebase Cloud Messaging. Opcionales.
# Usan el mismo proyecto de Firebase de arriba y le suman lo que solo pide la
# mensajeria. Basta la VAPID key: el remitente se deduce de VITE_FIREBASE_APP_ID
# (1:<remitente>:web:...). Sin la VAPID key los avisos quedan apagados y la app
# funciona igual; ojo, que asi fue como QA se quedo sin push (QA 4.2).
#   - VAPID: Configuracion del proyecto > Cloud Messaging > Web Push certificates.
#   - MESSAGING_SENDER_ID (opcional): Configuracion del proyecto > General.
# Los avisos web exigen HTTPS (localhost cuenta como seguro).
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_VAPID_KEY=
# VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com

# Solo desarrollo local. true = simula POST /api/v1/auth/conductor sin backend.
# En produccion no definir o dejar en false. Cuando el endpoint real exista,
# apagalo: el resto del codigo de HU-129 no se toca.
VITE_AUTH_CONDUCTOR_SIMULADO=true

# Teselas del mapa (opcional). Por defecto: tile.openstreetmap.org (solo para
# desarrollo y demo). Una o varias URL con {z}/{x}/{y}, separadas por coma.
# VITE_MAPA_TESELAS=https://tiles.ejemplo.gt/{z}/{x}/{y}.png
# VITE_MAPA_TESELAS_OSCURO=
# VITE_MAPA_ATRIBUCION=© OpenStreetMap

# Solo desarrollo (npm run dev): ubicacion fija del pasajero en lugar del GPS,
# para probar la reserva sin estar en Jalapa. Se ignora en el build.
# Ejemplo: junto a la parada "1a Calle - Mercado".
# VITE_UBICACION_SIMULADA=14.6326,-89.9871


# ---------------------------------------------------------------------------
# Para desplegar (QA y produccion)  --  HU-87
# ---------------------------------------------------------------------------
# Este archivo NO se usa en la imagen: .dockerignore lo deja fuera. En el
# despliegue las VITE_* llegan como --build-arg al `docker build` (ver
# dockerfile) y Vite las hornea en el bundle al compilar. Cambiar una exige
# reconstruir la imagen.
#
# En produccion:
#   - VITE_API_BASE_URL apunta al backend real (https://...), nunca a localhost.
#   - VITE_AUTH_CONDUCTOR_SIMULADO no se define (o va en false).
#
# La lista de variables obligatorias del pipeline vive en la variable del repo
# VITE_REQUIRED_BUILD_ARGS (.github/workflows/desplegar.yml). Para verificar una
# imagen ya construida: test/SCRUM-11-HU-87/manual.md.
